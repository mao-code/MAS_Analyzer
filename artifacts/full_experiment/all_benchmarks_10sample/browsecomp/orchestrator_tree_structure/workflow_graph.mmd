---
config:
  flowchart:
    curve: linear
---
graph TD;
	START([START<hr/><small><em>kind = terminal
description = Workflow entrypoint.</em></small>]):::first
	END([END<hr/><small><em>kind = terminal
description = Workflow exit.</em></small>]):::last
	root_plan(root_plan<hr/><small><em>kind = workflow_node
description = Root planner artifact.</em></small>)
	manager_dispatch(manager_dispatch<hr/><small><em>kind = workflow_node
description = Root-to-manager routing.</em></small>)
	manager_nodes(manager_nodes<hr/><small><em>kind = workflow_node
description = Manager decomposition stage.</em></small>)
	worker_dispatch(worker_dispatch<hr/><small><em>kind = workflow_node
description = Manager-to-leaf routing.</em></small>)
	worker_nodes(worker_nodes<hr/><small><em>kind = workflow_node
description = Leaf execution stage.</em></small>)
	worker_relay(worker_relay<hr/><small><em>kind = workflow_node
description = Leaf-to-manager bounded reports.</em></small>)
	manager_reducers(manager_reducers<hr/><small><em>kind = workflow_node
description = Per-manager aggregation.</em></small>)
	manager_relay(manager_relay<hr/><small><em>kind = workflow_node
description = Manager-to-root bounded reports.</em></small>)
	root_reducer(root_reducer<hr/><small><em>kind = workflow_node
description = Root aggregation.</em></small>)
	descriptor_monitor(descriptor_monitor<hr/><small><em>kind = workflow_node
description = Shared descriptor hook.</em></small>)
	termination_checker(termination_checker<hr/><small><em>kind = workflow_node
description = Explicit cycle stopper.</em></small>)
	finalize(finalize<hr/><small><em>kind = workflow_node
description = Finalize the run.</em></small>)
	START --> root_plan;
	root_plan --> manager_dispatch;
	manager_nodes --> worker_dispatch;
	worker_nodes --> worker_relay;
	worker_relay --> manager_reducers;
	manager_reducers --> manager_relay;
	manager_relay --> root_reducer;
	root_reducer --> descriptor_monitor;
	descriptor_monitor --> termination_checker;
	finalize --> END;
	manager_dispatch -- &nbsp;parallel Send fan-out&nbsp; --> manager_nodes;
	manager_dispatch -- &nbsp;else&nbsp; --> worker_dispatch;
	worker_dispatch -- &nbsp;parallel Send fan-out&nbsp; --> worker_nodes;
	worker_dispatch -- &nbsp;else&nbsp; --> worker_relay;
	termination_checker -- &nbsp;conditional&nbsp; --> manager_dispatch;
	termination_checker -- &nbsp;conditional&nbsp; --> finalize;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
