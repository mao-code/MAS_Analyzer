# Copy this file to .env and fill in your keys.
# .env is gitignored and will NOT be pushed to the repo.

# Core LLM provider
OPENROUTER_API_KEY=
# Optional override for the 4096-token hard ceiling on one provider completion.
# This prevents malformed JSON/control responses from consuming the model's full
# output window.
# OPENROUTER_MAX_TOKENS=1024

# Optional OpenAI-compatible judge / fallback provider
OPENAI_API_KEY=
OPENAI_API_BASE=

# Hugging Face assets / downloads
HF_TOKEN=

# StableToolBench
TOOLBENCH_KEY=
# STABLETOOLBENCH_VIRTUAL_SERVER_URL=http://localhost:8080/virtual

# Finance Agent
TAVILY_API_KEY=
SEC_EDGAR_API_KEY=
