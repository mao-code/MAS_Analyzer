# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/
.DS_Store

# --- Secrets and local config ---
# config/ holds the researcher's own experiment.toml (may contain API keys).
# Only the checked-in examples and shared assets are tracked.
.env
config/*
!config/*.example.toml
!config/benchmarks/
!config/benchmarks/*.toml
!config/topology_playbook.json
!config/topology_skill.md
!config/verify_selfevo_fix.toml
!config/manta_ablation_tasks_seed42.json
!config/manta_ablation_tasks_30_seed42.json

# --- Benchmark assets (downloaded, not vendored) ---
.cache/
data/
benchmark/browsecomp/data/
benchmark/webshop/data/
benchmark/stabletoolbench/data/
benchmark/stabletoolbench/tool_response_cache/
benchmark/stabletoolbench/tools/
benchmark/stabletoolbench/server.log
third_party/BrowseComp-Plus/

# --- Experiment outputs ---
artifacts/*
outputs/
/outputs
outputs_agentsquare_reproduce/
outputs_aflow_reproduce/
run_logs/
logs_verify/
*/Plot/
*/logs/
experiment_summary.csv
experiment_summary.json
run_*.trajectory.json
run_*.trace_metrics.json
summary.csv
mas_failure_analysis_report.html

# --- Paper drafts (kept out of the code repo) ---
AAAI2027/
PAPER_DRAFT.md

# --- Editor / agent local state ---
.claude/*

